# How a board is made — perception to tap log.
# Render: d2 --layout elk --theme 0 pipeline.d2 pipeline.svg
#         d2 --layout elk --theme 200 pipeline.d2 pipeline-dark.svg

direction: down

vars: {
  d2-config: {
    pad: 16
  }
}

perceive: "1 · perceive" {
  direction: right
  frame: "JPEG frame"
  gate: "change gate\nskip the VLM if the\nscene hasn't moved"
  vlm: "Qwen2.5-VL-3B\none-sentence scene"
  audio: "16 kHz audio"
  whisper: "Whisper base.en\nlocal transcription"
  store: "personal context store\npeople · events · needs"
  frame -> gate -> vlm
  audio -> whisper
}

ctx: "context vector · 769-d"

candidates: "2 · generate candidates" {
  direction: right
  teacher: "teacher path\nQwen2.5-3B over-generates\nacross 9 communicative functions"
  student: "student path\nMiniLM embeddings →\ndistilled MLP 769→192→95"
  openvocab: "open-vocabulary extractor\nreads answers straight\nout of the context"
}

select: "3 · select" {
  direction: right
  quota: "answer quota\nreserved when a\nquestion was asked"
  mmr: "MMR\nrelevant AND\nmutually different"
  pin: "pin 4 core words\nyes · no · help · wait"
  quota -> mmr -> pin
}

board: "10-slot board\nARASAAC pictograms → WebSocket → tablet"
tap: "every tap logged with the\ncontext that produced it"

perceive.vlm -> ctx
perceive.whisper -> ctx
perceive.store -> ctx
ctx -> candidates
candidates -> select.quota: candidate pool
select.pin -> board -> tap

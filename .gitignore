# Secrets / env
.env
.env.*
*.pem
*.key

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Runtime tap log (interaction data — kept locally, not in the code repo)
mac/taps.jsonl

# Personal context profile (real profile is private; sample is committed)
mac/personal_context.json

# Arduino / build artifacts
build/
*.bin
*.elf

# macOS
.DS_Store

# eval prediction caches (regenerable artifacts)
mac/evaluation/preds-*.jsonl

# OpenVINO artifacts — large/regenerable (minilm, whisper, accuracy json) ignored;
# only the small student IRs are committed (negations below beat the *.bin rule
# above). The .vocab.sha sidecars MUST ship with the IRs — the loader refuses to
# serve an IR whose vocab it cannot verify, so an IR without its sidecar is dead
# weight in git.
mac/intel/artifacts/*
!mac/intel/artifacts/student_fp32.xml
!mac/intel/artifacts/student_fp32.bin
!mac/intel/artifacts/student_int8.xml
!mac/intel/artifacts/student_int8.bin
!mac/intel/artifacts/*.vocab.sha
.codex/
AGENTS.md
PLAN.md
!mac/intel/artifacts/e2e_*.json
!mac/intel/artifacts/whisper_bench_*.json
!mac/intel/artifacts/head_bench_*.json
!mac/intel/artifacts/int8_accuracy.json
!mac/intel/artifacts/teacher_slice_*.jsonl
!mac/intel/artifacts/phase4_results_*.json
!mac/intel/artifacts/*.log
!mac/intel/artifacts/*_error.txt

# Bi-encoder quantization sweep outputs (regenerable by intel/biencoder_pareto.py;
# PARETO.md is copied into the docs when it is worth keeping)
mac/intel/artifacts/biencoder/

# Isolated export toolchain (optimum-intel pins transformers<5.1; see mac/intel/README.md)
.venv-export/

# built PDFs
docs/overview/*.pdf

# docs/ is private apart from the README charts
docs/*
!docs/figures/
